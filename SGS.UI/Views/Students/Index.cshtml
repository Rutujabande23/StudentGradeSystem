@model List<SGS.Domain.Entities.Student>

@{
    ViewData["Title"] = "Student List";
}

<h2>Student Grade Management System</h2>

<p>
    <a asp-controller="Students"
       asp-action="Create"
       class="btn btn-primary">
        Add Student
    </a>

    <a asp-controller="Students"
       asp-action="AverageGrade"
       class="btn btn-success">
        Average Grade
    </a>

    <a asp-controller="Students"
       asp-action="HighestGrade"
       class="btn btn-info">
        Highest Grade
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Name</th>
            <th>Subject</th>
            <th>Grade</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var student in Model)
            {
                <tr>
                    <td>@student.StudentId</td>
                    <td>@student.Name</td>
                    <td>@student.Subject</td>
                    <td>@student.Grade</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    No students found.
                </td>
            </tr>
        }
    </tbody>
</table>
