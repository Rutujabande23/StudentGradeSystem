@model SGS.Domain.Entities.Student

@{
    ViewData["Title"] = "Add Student";
}

<h2>Add Student</h2>

<form asp-controller="Students"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Student Name
        </label>

        <input asp-for="Name" class="form-control"
               placeholder="Enter student name" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Subject" class="form-label">
            Subject
        </label>

        <input asp-for="Subject" class="form-control"
               placeholder="Enter subject" />

        <span asp-validation-for="Subject"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Grade" class="form-label">
            Grade (0–100)
        </label>

        <input asp-for="Grade" type="number"
               class="form-control"
               min="0" max="100" step="0.01"
               placeholder="Enter grade" />

        <span asp-validation-for="Grade"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Student
    </button>

    <a asp-controller="Students"
       asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</form>
