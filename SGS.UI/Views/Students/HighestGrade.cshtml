@model SGS.Domain.Entities.Student?

@{
    ViewData["Title"] = "Highest Grade";
}

<h2>Student with Highest Grade</h2>

<div class="card p-4 mt-3" style="max-width: 500px;">

    @if (Model != null)
    {
        <h4 class="text-success">@Model.Name</h4>

        <hr />

        <p>
            <strong>Student ID:</strong>
            @Model.StudentId
        </p>

        <p>
            <strong>Subject:</strong>
            @Model.Subject
        </p>

        <p>
            <strong>Grade:</strong>
            @Model.Grade
        </p>
    }
    else
    {
        <p class="text-muted">No students found.</p>
    }

    <a asp-controller="Students"
       asp-action="Index"
       class="btn btn-primary">
        Back to Student List
    </a>

</div>
